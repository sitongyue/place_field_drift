Python conversion of MATLAB Figure 3.3:
Normalized decoding errors for spike and LFP decoders,
trials from all five folds sorted in chronological order.
"""

import numpy as np
import scipy.io as sio
import h5py
import matplotlib.pyplot as plt
from keras import models, layers, activations, backend, constraints
from scipy.ndimage import gaussian_filter

# ── paths ─────────────────────────────────────────────────────────────────────
fldr      = '/content/drive/MyDrive/beatLab/processed-rat-data/'
LFP_fldr  = '/content/drive/MyDrive/beatLab/raffi_trained_LFP_models_spikes/'

n_sess   = 4
ks = [64]
sigs = [.11]
folds = 5

def compute_errors(Yhat, km, pos):
    """Compute normalized position error for each sample."""
    xyg = km[Yhat, :]
    new_xyg = []
    new_pos = []
    for i in range(len(pos[:,1])):
      if pos[i,1] < 3:
        new_pos = np.append(new_pos, pos[i,0]+pos[i,1])
      if pos[i,1] >= 3:
        new_pos = np.append(new_pos, -pos[i,0]+pos[i,1]+1)
    for i in range(len(xyg[:,1])):
      if xyg[i,1] < 3:
        new_xyg = np.append(new_xyg, xyg[i,0]+xyg[i,1])
      if xyg[i,1] >=3:
        new_xyg = np.append(new_xyg, -xyg[i,0]+xyg[i,1]+1)
    err = new_xyg - new_pos
    err[(new_xyg - new_pos)>.3] = np.nan #if error is bigger than .3 or smaller than -.3 it becomes nan because that is a mistake from the decoder and not significant to showing drift
    err[(new_xyg - new_pos)<-.3] = np.nan
    err[xyg[:, 1] != pos[:, 1]] = np.nan  # wrong arm gives error of 1
    return err


def load_keras_weights(model, filepath):
    """Load weights from .weights.h5 file into a Keras model."""
    model.load_weights(filepath)
    return model


# ── main computation ──────────────────────────────────────────────────────────
# err_allsess[i] = dict with keys 'spk', 'time_inds'
#   each value is a list of per-sample arrays (one per fold)
err_allsess2 = []

for i in range(n_sess):
    sess = i + 1
    print(f'\n=== Session {sess} ===')

    mat = sio.loadmat(fldr + f'pyDat{sess}0.mat')
    pos = mat['pos']
    lapID = mat['lapID']
    pos = filter_data(pos, cutoff=4, fs=25, filt_type='low').astype(np.float32)
    vel = mat['vel'].ravel()
    pos = pos-np.min(pos,axis=0)
    pos = pos/np.expand_dims(np.max(pos,axis=0),axis=0)
    pos = np.hstack((pos,mat['lapID'][:,2].reshape((-1,1))))
    mask = (((lapID[:,4] == 1) & (vel > 6)) | ((lapID[:,4] == 3) & (vel < -6)))
    mask = mask.ravel()
    pos = pos[mask]
    pos[:,0] = pos[:,0]/np.max(pos[:,0])

    lapID = lapID[mask]

    # RBF targets
    Y, km = makeRBF_linear2(pos, int(ks[0]), sigs[0])
    num_chans = Y.shape[1]

    err_LFP_folds  = np.zeros(Y.shape[0])

    X_orig = mat['X'][mask].copy()  # save original before fold loop

    for kk in range(folds):
        fold = kk + 1
        print(f'\n Fold {fold}')
        inds_test  = lapID[:, 1] == fold
        inds_train = lapID[:, 1] != fold

        wLFPs, _, _ = whiten(X_orig, inds_train)
        X_w = wLFPs * np.exp(-1j * np.angle(wLFPs[:,0])).reshape((-1,1))
        X_w = np.concatenate((np.real(X_w), np.imag(X_w)), axis=1)

        # use lap number (lapID[:,0]) as the time index for each test sample
        backend.clear_session()
        LFP_model = models.Sequential([
            layers.Dense(num_chans, input_shape=(X_w.shape[1],),
                         kernel_constraint=constraints.unit_norm()),
            layers.Activation(activations.softmax)
        ])
        LFP_model.load_weights(
            f'{LFP_fldr} model_sess{i}_fold{kk}_k0_sig0.weights.h5'
        )

        Yhat_LFP = np.argmax(LFP_model.predict(X_w[inds_test], verbose=0), axis=1)
        err_LFP  = compute_errors(Yhat_LFP, km, pos[inds_test])
        err_LFP_folds[inds_test] = err_LFP

#list of four vectors
    err_allsess2.append({
        'LFP':       err_LFP_folds,
        'lapID':     lapID
    })


# ── plotting ──────────────────────────────────────────────────────────────────

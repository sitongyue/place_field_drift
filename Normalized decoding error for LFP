    #time_inds_all = np.concatenate(err_allsess[i]['time_inds'])
    #sort_order    = np.argsort(time_inds_all, kind='stable')
    err_spk_sorted2 = err_spk_all2
    t = np.arange(len(err_spk_sorted2))
    lapID = err_allsess2[i]['lapID']

    betweentrials = []
    for i in range(1, len(lapID[:,0])):
      if lapID[i,0] > lapID[i-1,0]:
        betweentrials.append(t[i])

    ax.plot(t, err_spk_sorted2, color='firebrick', linewidth=0.5, label=f'LFP Error ({ks[0]} RBFs)')
    ax.axhline(0, color='black', linewidth=0.8, linestyle='--')
    #for bt in betweentrials:
    #  ax.axvline(bt, color='purple')

    # rolling mean
    masked_errors = err_spk_sorted2.copy()
    masked_errors[err_spk_sorted2 == 0] = np.nan  # mask zeroed-out errors
    window = 500
    mean_err = np.array([
       np.nanmean(masked_errors[max(0, j-window//2):min(len(masked_errors), j+window//2)])
        for j in range(len(masked_errors))
    ])
    ax.plot(t, mean_err, color='blue', linewidth=2, label=f'Mean error (window={window})')

    ax.set_ylim(-0.4, 0.4)
    ax.set_xlim(0, len(t)) #total = len(t) # change based on zooming into data
    ax.set_title(f'Session {sess}', fontsize=myFontSize)
    ax.legend(fontsize=10)

fig.supxlabel('Time steps (Concatenated Trials)', fontsize=myFontSize)
